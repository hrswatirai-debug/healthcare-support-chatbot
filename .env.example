# Copy this file to `.env` and fill in ONE provider's key.
# Never commit the real .env (it is git-ignored).

# Which provider to use: auto | anthropic | openai | gemini | mock
# "auto" picks whichever key below is present. "mock" runs offline (no key, for tests).
LLM_PROVIDER=auto

# --- Provide exactly one of these ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional model overrides ---
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash

# --- n8n orchestration (optional) ---
# Shared secret so only n8n may call the FastAPI engine.
ENGINE_API_KEY=change-me
# If set, the Streamlit UI routes each turn through this n8n webhook instead of
# calling the engine directly. Leave blank to run the engine in-process.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat
# n8n editor login (docker-compose):
N8N_USER=admin
N8N_PASSWORD=change-me

# --- Optional tuning ---
# RAG_TOP_K=3
# RAG_MIN_SIMILARITY=0.05
# SQL_MAX_ROWS=50
